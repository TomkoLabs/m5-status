#!/usr/bin/env python3
"""A small macOS resource monitor using native tools and Python's stdlib."""

import argparse
import ctypes
import datetime
import json
import math
import os
import plistlib
import re
import signal
import shutil
import socket
import subprocess
import sys
import time
import textwrap
from xml.parsers.expat import ExpatError

VERSION = "0.1.0"


class CollectorError(Exception):
    pass


def native_plist(data):
    try:
        return plistlib.loads(data)
    except (plistlib.InvalidFileException, ExpatError, ValueError, TypeError, OverflowError):
        raise CollectorError("native property list invalid") from None


class Commands:
    """Bound each command; reap its process group on timeout or interruption."""

    def __init__(self):
        self.child = None

    def close(self):
        if self.child is not None:
            child, self.child = self.child, None
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            child.communicate()

    def run(self, argv, timeout=3):
        env = dict(os.environ, LC_ALL="C", LANG="C")
        try:
            self.child = subprocess.Popen(
                argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                env=env, start_new_session=True)
            out, err = self.child.communicate(timeout=timeout)
            status = self.child.returncode
        except subprocess.TimeoutExpired:
            raise CollectorError("{} timed out ({}s)".format(argv[0], timeout))
        except OSError as exc:
            raise CollectorError("{}: {}".format(argv[0], exc.strerror))
        finally:
            self.close()
        if status:
            # Never echo arbitrary command output (which may contain private data).
            if b"superuser" in err or b"superuser" in out:
                raise CollectorError("powermetrics requires root")
            raise CollectorError("{} exited {}".format(argv[0], status))
        return out


def clean(value):
    """Prevent host, mount and process names from injecting terminal controls."""
    return "".join(c if c.isprintable() else "?" for c in str(value))


def size(value):
    if value is None:
        return "N/A"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(value) < 1024 or unit == "TiB":
            return "{:.2f} {}".format(value, unit)
        value /= 1024


def meter(percent, width=24):
    filled = round(max(0, min(100, percent)) * width / 100)
    return "[{}{}] {:5.1f}%".format("#" * filled, "-" * (width - filled), percent)


def interval(value):
    if not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", value):
        raise argparse.ArgumentTypeError("interval must be a positive decimal in seconds")
    number = float(value)
    if not math.isfinite(number) or not 0 < number <= 86400:
        raise argparse.ArgumentTypeError("interval must be greater than 0 and at most 86400 seconds")
    return number


def cpu_delta(before, after):
    # HOST_CPU_LOAD_INFO order: user, system, idle, nice. Counters are uint32.
    delta = [(b - a) & 0xffffffff for a, b in zip(before, after)]
    total = sum(delta)
    if not total:
        raise CollectorError("CPU sample has no elapsed ticks")
    return 100 * (total - delta[2]) / total


class CPU:
    def __init__(self):
        self.lib = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
        self.lib.mach_host_self.restype = ctypes.c_uint
        self.lib.host_statistics.argtypes = [ctypes.c_uint, ctypes.c_int,
                                            ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint)]
        self.lib.host_statistics.restype = ctypes.c_int
        self.lib.mach_port_deallocate.argtypes = [ctypes.c_uint, ctypes.c_uint]
        self.port = self.lib.mach_host_self()

    def read(self):
        ticks = (ctypes.c_uint * 4)()
        count = ctypes.c_uint(4)
        if self.lib.host_statistics(self.port, 3, ticks, ctypes.byref(count)):
            raise CollectorError("Mach CPU statistics unavailable")
        return list(ticks)

    def close(self):
        task = ctypes.c_uint.in_dll(self.lib, "mach_task_self_").value
        self.lib.mach_port_deallocate(task, self.port)


def parse_vm(text):
    match = re.search(r"page size of (\d+) bytes", text)
    if not match:
        raise CollectorError("vm_stat page size missing")
    page = int(match[1])
    values = {key.strip(' "'): int(value) * page
              for key, value in re.findall(r"^([^:\n]+):\s+(\d+)\.", text, re.M)}
    required = ("Pages free", "Anonymous pages", "Pages wired down",
                "Pages occupied by compressor", "File-backed pages", "Pages purgeable")
    if any(key not in values for key in required):
        raise CollectorError("vm_stat required fields missing")
    values["page_size"] = page
    values["non_file_estimate"] = (values["Anonymous pages"] + values["Pages wired down"]
                                   + values["Pages occupied by compressor"])
    return values


def parse_swap(text):
    values = {}
    for key, value, unit in re.findall(r"(total|used|free)\s*=\s*([\d.]+)([KMGTP])", text):
        values[key] = float(value) * 1024 ** ("KMGTP".index(unit) + 1)
    if not {"total", "used", "free"} <= values.keys():
        raise CollectorError("swap fields missing")
    return values


def pressure_label(value):
    # The sysctl exposes dispatch constants, not XNU's internal 0..4 enum.
    return {1: "normal", 2: "warning", 4: "critical"}.get(value, "unknown ({})".format(value))


def parse_processes(text):
    rows = []
    for line in text.splitlines():
        fields = line.split(None, 3)
        if len(fields) != 4:
            continue
        pid, cpu, rss, name = fields
        try:
            rows.append((int(pid), clean(os.path.basename(name))[:30], float(cpu), int(rss) * 1024))
        except ValueError:
            continue
    if not rows:
        raise CollectorError("process snapshot empty")
    return rows


def busiest(rows, count=5):
    # Union keeps a mostly idle inference server visible when it has large RSS.
    selected = sorted(rows, key=lambda r: r[2], reverse=True)[:count]
    selected += [r for r in sorted(rows, key=lambda r: r[3], reverse=True)[:count]
                 if r[0] not in {p[0] for p in selected}]
    return selected


def parse_df(text):
    rows = []
    for line in text.splitlines()[1:]:
        parts = line.split(None, 5)
        if len(parts) == 6 and parts[0].startswith("/dev/"):
            rows.append(dict(device=parts[0].removeprefix("/dev/"),
                             total=int(parts[1]) * 1024, used=int(parts[2]) * 1024,
                             free=int(parts[3]) * 1024, mount=parts[5]))
    return rows


def storage_rows(df_rows, apfs):
    by_volume = {}
    for container in apfs.get("Containers", []):
        for volume in container.get("Volumes", []):
            by_volume[volume["DeviceIdentifier"]] = container
    seen, rows = set(), []
    for entry in df_rows:
        # APFS boot snapshots have an extra sN after their volume device.
        device = entry["device"]
        container = by_volume.get(device) or by_volume.get(re.sub(r"s\d+$", "", device))
        identity = container["ContainerReference"] if container else device
        if identity in seen:
            continue
        seen.add(identity)
        if container:
            total, free = container["CapacityCeiling"], container["CapacityFree"]
            rows.append((clean(entry["mount"]), total, total - free, free, True))
        else:
            rows.append((clean(entry["mount"]), entry["total"], entry["used"], entry["free"], False))
    return rows


def parse_native_gpu(text):
    active = re.search(r"GPU active residency:\s*([\d.]+)%", text)
    power = re.search(r"GPU Power:\s*([\d.]+)\s*mW", text)
    if not active or not number(float(active[1]), high=100):
        raise CollectorError("powermetrics GPU active residency unavailable")
    result = {"percent": float(active[1]), "source": "native active"}
    if power and number(float(power[1]), low=0.000001, high=1000000):
        result["power"] = float(power[1]) / 1000
    return result


def number(value, low=0, high=math.inf):
    return (isinstance(value, (int, float)) and not isinstance(value, bool)
            and math.isfinite(value) and low <= value <= high)


def parse_macmon(raw, now=None):
    """Use explicit active residency, never a missing/defaulted scaled ratio."""
    try:
        doc = json.loads(raw)
        timestamp = datetime.datetime.fromisoformat(doc["timestamp"].replace("Z", "+00:00"))
        if timestamp.tzinfo is None:
            raise ValueError()
        age = (datetime.datetime.now(datetime.timezone.utc) if now is None else now) - timestamp
        if not -2 <= age.total_seconds() <= 5:
            raise CollectorError("macmon sample is stale")
        active = doc["gpu_active_ratio"]
        if not number(active, high=1):
            raise ValueError()
        result = {"percent": active * 100, "source": "macmon active"}
        frequency = doc.get("gpu_freq_mhz")
        freqs = doc.get("soc", {}).get("gpu_freqs", [])
        maximum = max((f for f in freqs if number(f, low=1)), default=None)
        if number(frequency, low=1) and (maximum is None or frequency <= maximum):
            result["mhz"] = frequency
            if maximum is not None:
                result["max_mhz"] = maximum
        if number(doc.get("gpu_scaled_ratio"), high=1):
            result["scaled"] = doc["gpu_scaled_ratio"] * 100
        # Zero temperatures/power can be unsupported private counters. Hide them.
        if number(doc.get("temp", {}).get("gpu_temp_avg"), low=1, high=150):
            result["temperature"] = doc["temp"]["gpu_temp_avg"]
        if number(doc.get("gpu_power"), low=0.000001, high=1000):
            result["power"] = doc["gpu_power"]
        return result
    except (KeyError, TypeError, ValueError, AttributeError):
        raise CollectorError("macmon GPU fields malformed or unsupported") from None


def has_gpu_channel(devices):
    """Require a single real aggregate channel; unsupported counters can be zero."""
    channels = []
    for device in devices:
        for legend in device.get("IOReportLegend", []):
            if legend.get("IOReportSubGroupName") != "GPU Performance States":
                continue
            for channel in legend.get("IOReportChannels", []):
                if channel and isinstance(channel[0], int) and 0 <= channel[0] < 2 ** 64:
                    if channel[0].to_bytes(8, "big").lstrip(b"\0") == b"GPUPH":
                        channels.append(channel[0])
    return len(channels) == 1


def driver_gpu(devices):
    if len(devices) != 1:
        raise CollectorError("driver has no single aggregate GPU")
    stats = devices[0].get("PerformanceStatistics", {})
    percent = stats.get("Device Utilization %")
    if not number(percent, high=100):
        raise CollectorError("driver GPU field unavailable")
    return {"percent": percent, "source": "driver snapshot", "driver_fields": stats}


def choose_gpu(sample, driver):
    if isinstance(sample, dict):
        return sample
    if isinstance(driver, dict):
        return driver
    return {"percent": None, "source": "unavailable"}


def capacity(used, total):
    if total >= 1024 ** 3:
        return "{:.2f} / {:g} GiB".format(used / 1024 ** 3, round(total / 1024 ** 3, 2))
    return "{} / {}".format(size(used), size(total))


def storage_label(info):
    # SolidState comes from disk identity; never infer NVMe from an APFS volume.
    return "SSD" if info.get("SolidState") is True else "Disk" if info.get("SolidState") is False else "Storage"


def render_snapshot(data, width=100, details=False, color=False):
    """Format plain lines first, then color; never let ANSI affect width decisions."""
    width = max(20, width)
    bar_width = max(4, min(24, width - 68))
    lines = []

    def add(value="", indent=""):
        value = clean(value).encode("ascii", "replace").decode()
        lines.extend(textwrap.wrap(value, width=width, subsequent_indent=indent,
                                   break_long_words=True, break_on_hyphens=False) or [""])

    def row(label, percent, extra=""):
        main = "{:<7} {}".format(label, meter(percent, bar_width) if percent is not None else "N/A")
        if extra:
            if len(main) + len(extra) + 2 <= width:
                main += "  " + extra
            else:
                add(main)
                add("        " + extra, "        ")
                return
        add(main)

    static = data["static"]
    elapsed = data["uptime"]
    days, rest = divmod(elapsed, 86400)
    hours, rest = divmod(rest, 3600)
    mode = "Once" if data["once"] else "Refresh {:g}s".format(data["interval"])
    add("{} | {} CPU / {} GPU cores | {} | Uptime {}d {}h {}m".format(
        static["chip"].removeprefix("Apple "), static["cpu"], static["gpu"], mode, days, hours, rest // 60))
    add("{} | {}".format(data["host"], data["timestamp"]))
    add()
    row("CPU", data["cpu"])
    gpu = data["gpu"]
    extra = gpu["source"]
    if "mhz" in gpu:
        extra += " | {:g}{} MHz".format(gpu["mhz"], " / {:g}".format(gpu["max_mhz"]) if "max_mhz" in gpu else "")
    row("GPU", gpu["percent"], extra)
    vm = data["vm"]
    used = vm["non_file_estimate"] if vm else None
    row("RAM~", 100 * used / data["total"] if used is not None else None,
        capacity(used, data["total"]) if used is not None else "collector failed")
    for i, (mount, total, used, free, _shared) in enumerate(data["disks"] or []):
        label = data["labels"].get(mount, "Storage") + (str(i + 1) if i else "")
        row(label, 100 * used / total if total else None,
            "{} ({} free)".format(capacity(used, total), size(free)))
    if not data["disks"]:
        row("Storage", None, "collector failed")
    swap = data["swap"]
    if isinstance(swap, dict):
        row("Swap", 100 * swap["used"] / swap["total"] if swap["total"] else None,
            "{} / {}{}".format(size(swap["used"]), size(swap["total"]),
                " (not allocated)" if not swap["total"] else ""))
    else:
        row("Swap", None, "unavailable")
    add()
    add("Pressure: {} | File-backed: {}".format(data["pressure"], size(vm["File-backed pages"]) if vm else "N/A"))
    add()
    add("Processes (top CPU + RSS)")
    name_width = max(6, min(26, width - 30))
    add("    PID  {:<{w}}  CPU%       RSS".format("PROCESS", w=name_width))
    for pid, name, pcpu, rss in busiest(data["processes"] or [], 5 if details else 3):
        add("{:7d}  {:<{w}} {:5.1f} {:>10}".format(pid, name[:name_width], pcpu, size(rss), w=name_width))
    if details:
        add()
        add("Details | m5-status {} | macOS {} / {}".format(VERSION, static["os"], static["model"]))
        add("Load 1/5/15m: " + " / ".join("{:.2f}".format(v) for v in data["load"]))
        add("CPU: 100% = whole machine; process CPU: 100% = one core. RSS may share pages.")
        if vm:
            add("RAM~ = anonymous {} + wired {} + compressor {}".format(
                size(vm["Anonymous pages"]), size(vm["Pages wired down"]), size(vm["Pages occupied by compressor"])))
            add("Free pages: {} | purgeable: {} | VM page: {}".format(
                size(vm["Pages free"]), size(vm["Pages purgeable"]), size(vm["page_size"])))
            add("Compressed logical: " + size(vm.get("Pages stored in compressor")))
            add("Non-file estimate, not App Memory. Cache/purgeable categories overlap; file-backed is not all immediately available.")
        add("Swap capacity is currently allocated, not a fixed maximum or a pressure classification.")
        for mount, total, used, free, shared in data["disks"] or []:
            add("{} | {} | {}{} | {} available".format(data["labels"].get(mount, "Storage"), mount,
                capacity(used, total), " | shared APFS container" if shared else "", size(free)))
        add("GPU source: " + gpu["source"])
        if gpu["source"] in ("macmon active", "native active"):
            add("GPU active residency: fraction of 250ms sample active; not peak throughput.")
        if "scaled" in gpu:
            add("GPU frequency-scaled activity: {:.1f}%".format(gpu["scaled"]))
        if "driver_fields" in gpu:
            stats = gpu["driver_fields"]
            add("Driver renderer: {}% | tiler: {}% | sampling window unknown; may be stale".format(
                stats.get("Renderer Utilization %", "N/A"), stats.get("Tiler Utilization %", "N/A")))
        add("GPU temperature: " + ("{:.1f} C".format(gpu["temperature"]) if "temperature" in gpu else "unavailable"))
        add("GPU power: " + ("{:.2f} W (sampler estimate)".format(gpu["power"]) if "power" in gpu else "unavailable"))
        for note in data["gpu_notes"]:
            add("GPU: " + note)
        add("Collection: {:.2f}s | core commands bounded at 3s".format(data["collection"]))
    for error in data["errors"]:
        add("ERROR: " + error)
    if color:
        lines = ["\033[36m" + line + "\033[0m" if "[" in line and "%" in line else line for line in lines]
    return "\n".join(lines) + "\n"


class Monitor:
    def __init__(self, commands, args):
        self.commands, self.args = commands, args
        self.optional_failures = {}
        self.cpu = CPU()
        self.static = {}
        for key in ("hw.memsize", "hw.ncpu", "hw.model", "machdep.cpu.brand_string",
                    "kern.boottime", "kern.osproductversion"):
            self.static[key] = self.text(["/usr/sbin/sysctl", "-n", key]).strip()
        self.total = int(self.static["hw.memsize"])
        match = re.search(r"sec = (\d+)", self.static["kern.boottime"])
        if not match or self.total <= 0:
            raise CollectorError("invalid physical memory or boot time")
        self.boot = int(match[1])
        devices = self.optional("GPU hardware", lambda: native_plist(self.commands.run(
            ["/usr/sbin/ioreg", "-r", "-c", "AGXAccelerator", "-a", "-d", "1"])))
        self.gpu_cores = str(sum(int(d.get("gpu-core-count", 0)) for d in devices)) if isinstance(devices, list) else "N/A"
        candidates = [shutil.which("macmon"), "/opt/homebrew/bin/macmon", "/usr/local/bin/macmon"]
        self.macmon = next((p for p in candidates if p and os.access(p, os.X_OK)), None)
        self.macmon_reason = "macmon not installed; using native driver fallback"
        if self.macmon and (not isinstance(devices, list) or not has_gpu_channel(devices)):
            self.macmon = None
            self.macmon_reason = "no single aggregate GPU residency channel; using driver fallback"
        initial_df = parse_df(self.text(["/bin/df", "-Pk", "-l"]))
        self.disk_paths = ["/System/Volumes/Data" if os.path.isdir("/System/Volumes/Data") else "/"]
        self.disk_paths += [d["mount"] for d in initial_df if d["mount"].startswith("/Volumes/")]
        self.disk_paths += args.disk
        self.disk_paths = list(dict.fromkeys(self.disk_paths))
        self.disk_labels = {}
        for path in self.disk_paths:
            info = self.optional("disk identity " + path, lambda path=path: native_plist(
                self.commands.run(["/usr/sbin/diskutil", "info", "-plist", path])))
            if isinstance(info, dict):
                # df reports the containing mount even when --disk names a directory.
                self.disk_labels[info.get("MountPoint", path)] = storage_label(info)

    def text(self, argv):
        return self.commands.run(argv).decode("utf-8", "replace")

    def optional(self, name, collect):
        # Sticky failure avoids repeating failed expensive calls or stderr spam.
        if name in self.optional_failures:
            return "N/A ({})".format(self.optional_failures[name])
        try:
            return collect()
        except (CollectorError, ValueError, KeyError, TypeError, AttributeError) as exc:
            self.optional_failures[name] = str(exc) or "invalid native data"
            return "N/A ({})".format(self.optional_failures[name])

    def frame(self, width=100, color=False):
        errors = []

        def core(name, collect):
            try:
                return collect()
            except (CollectorError, ValueError, KeyError, TypeError, AttributeError) as exc:
                errors.append("{}: {}".format(name, exc))
                return None

        start = time.monotonic()
        before = core("CPU", self.cpu.read)
        time.sleep(0.25)
        after = core("CPU", self.cpu.read)
        cpu = core("CPU", lambda: cpu_delta(before, after)) if before and after else None
        vm = core("RAM", lambda: parse_vm(self.text(["/usr/bin/vm_stat"])))
        swap = self.optional("swap", lambda: parse_swap(self.text(["/usr/sbin/sysctl", "-n", "vm.swapusage"])))
        pressure = self.optional("pressure", lambda: pressure_label(int(self.text(
            ["/usr/sbin/sysctl", "-n", "kern.memorystatus_vm_pressure_level"]))))
        disks = core("storage", lambda: storage_rows(
            parse_df(self.text(["/bin/df", "-Pk"] + self.disk_paths)),
            native_plist(self.commands.run(["/usr/sbin/diskutil", "apfs", "list", "-plist"]))))
        if disks == []:
            errors.append("storage: no local disk rows")
        processes = core("processes", lambda: parse_processes(self.text(
            ["/bin/ps", "-axo", "pid=,pcpu=,rss=,comm="])))
        notes, sampled = [], None
        if self.macmon:
            sampled = self.optional("macmon", lambda: parse_macmon(self.commands.run(
                [self.macmon, "pipe", "-s", "1", "-i", "250", "--soc-info"])))
            if isinstance(sampled, str):
                notes.append(sampled)
        else:
            notes.append(self.macmon_reason)
        if self.args.gpu:
            native = self.optional("powermetrics", lambda: parse_native_gpu(self.text(
                ["/usr/bin/powermetrics", "--samplers", "gpu_power", "-i", "250", "-n", "1"])))
            if isinstance(native, dict):
                sampled = native
            else:
                notes.append(str(native))
        driver = None
        if not isinstance(sampled, dict):
            driver = self.optional("driver GPU", lambda: driver_gpu(native_plist(self.commands.run(
                ["/usr/sbin/ioreg", "-r", "-c", "AGXAccelerator", "-a", "-d", "1"]))))
            if isinstance(driver, str):
                notes.append(driver)
        data = dict(static=dict(chip=self.static["machdep.cpu.brand_string"], cpu=self.static["hw.ncpu"],
                    gpu=self.gpu_cores, os=self.static["kern.osproductversion"], model=self.static["hw.model"]),
                    host=socket.gethostname(), timestamp=datetime.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z"),
                    uptime=max(0, int(time.time() - self.boot)), once=self.args.once, interval=self.args.seconds,
                    cpu=cpu, load=os.getloadavg(), vm=vm, total=self.total, swap=swap, pressure=pressure,
                    disks=disks, labels=self.disk_labels, processes=processes, gpu=choose_gpu(sampled, driver),
                    gpu_notes=notes, collection=time.monotonic() - start, errors=errors)
        return render_snapshot(data, width, self.args.details, color), bool(errors)


def main():
    parser = argparse.ArgumentParser(description="Native macOS resource monitor; Ctrl+C exits.")
    parser.add_argument("seconds", nargs="?", default=10.0, type=interval,
                        help="refresh interval in seconds (default: 10; positive decimal, max 86400)")
    parser.add_argument("--once", action="store_true", help="print one snapshot without terminal escapes")
    parser.add_argument("--details", action="store_true", help="include expanded accounting and collector diagnostics")
    parser.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    parser.add_argument("--gpu", action="store_true", help="add native powermetrics sampling (root); macmon is used automatically when installed")
    parser.add_argument("--disk", action="append", default=[], metavar="PATH",
                        help="also show the local filesystem containing PATH (repeatable)")
    args = parser.parse_args()
    for path in args.disk:
        if not os.path.exists(path):
            parser.error("disk path does not exist: " + path)
    if sys.platform != "darwin":
        parser.exit(1, "m5-status requires macOS; --help is available on any platform.\n")

    def stop(signum, _frame):
        raise SystemExit(128 + signum)

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, stop)
    commands = Commands()
    monitor = None
    terminal = sys.stdout.isatty() and os.environ.get("TERM", "dumb") != "dumb" and not args.once
    try:
        monitor = Monitor(commands, args)
        while True:
            started = time.monotonic()
            output, failed = monitor.frame(shutil.get_terminal_size(fallback=(100, 24)).columns, terminal and "NO_COLOR" not in os.environ)
            sys.stdout.write(("\033[2J\033[H" if terminal else "") + output)
            sys.stdout.flush()
            if args.once:
                return int(failed)
            if not terminal:
                print(flush=True)
            time.sleep(max(0, args.seconds - (time.monotonic() - started)))
    except BrokenPipeError:
        return 0
    except (CollectorError, OSError, ValueError) as exc:
        print("m5-status: " + clean(exc), file=sys.stderr)
        return 1
    finally:
        commands.close()
        if monitor is not None:
            monitor.cpu.close()
        if terminal:
            sys.stdout.write("\n")


if __name__ == "__main__":
    sys.exit(main())
